{
  "name": "@archastro/sdk",
  "version": "0.9.0",
  "description": "TypeScript SDK for the ArchAstro Platform API (Node, browser, React Native)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.native.js",
  "browser": "dist/index.js",
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "docs": "typedoc --options typedoc.json",
    "lint": "tsc --noEmit && npm run test:types",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:types": "npm run build && tsc -p tsconfig.type-tests.json",
    "test:contract": "vitest run --config __tests__/contract/vitest.contract.config.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArchAstro/archastro-js.git",
    "directory": "packages/sdk"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@archastro/channel-harness": "^0.4.0",
    "@stoplight/prism-cli": "^5.14.2",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.4.0",
    "vitest": "^4.1.3",
    "ws": "^8.17.0"
  },
  "keywords": [
    "archastro",
    "sdk",
    "react-native",
    "expo",
    "phoenix",
    "typescript"
  ],
  "optionalDependencies": {
    "ws": "^8.17.0"
  },
  "peerDependencies": {
    "ws": "^8.17.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  }
}
